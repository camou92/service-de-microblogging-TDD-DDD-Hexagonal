{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "extensionsToTreatAsEsm": [".ts"],
  "moduleNameMapper": {
    "^@app/crafty$": "<rootDir>/../../../libs/crafty/src",
    "^@app/crafty/(.*)$": "<rootDir>/../../../libs/crafty/src/$1",
    "^(\\.{1,2}/.*)\\.js$": "$1"
  },
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      {
        "useESM": true,
        "tsconfig": "<rootDir>/../../../tsconfig.spec.json"
      }
    ]
  }
}
